+def test_admission_with_the_real_adapter_stops_at_the_shutdown_gap_and_at_every_unconfirmed_input(runpod, tmp_path):
+    """With everything else confirmed, admission through ``RunPodProvider`` still refuses: no
+    provider-side shutdown can be armed. That is the intended state until the shutdown gap is
+    closed. Each unconfirmed input refuses earlier, with its own reason; nothing is reserved."""
+    clock = dur.ManualClock()
+    source = tmp_path / "workspace"
+    source.mkdir()
+    storage = dur.storage(source, LocalDirectoryDestination(tmp_path / "offsite"), source_path=str(source))
+    runpod.pods = [pod("pod-1", volume=VOLUME, mount=str(source))]
+    runpod.volumes = [VOLUME]
+    adapter = provider(runpod, clock)
+    planned = adapter.read_rates("worker-1")
+    reserve = (planned.storage_per_hour + planned.destination_per_hour) * dur.POLICY.retention_hours
+    controller = admission(tmp_path, adapter, clock, planned)
+    with pytest.raises(AdmissionRefused, match="no provider-side shutdown can be armed"):
+        controller.admit("worker-1", 3600.0, storage, reserve)
+    cases = {"currency of RunPod's rates is not confirmed": {"balance_confirmation": None},
+             "provider inputs are unavailable": {"storage_prices": None},
+             "not confirmed": {"local_pod_id": "pod-9"}}
+    for why, change in cases.items():
+        with pytest.raises(AdmissionRefused, match=why):
+            admission(tmp_path, provider(runpod, clock, **change), clock, planned).admit("worker-1", 3600.0, storage, reserve)
+    runpod.pods = [pod("pod-1", volume=VOLUME, mount=str(source), cost=1.7)]         # the price changed since the plan
+    with pytest.raises(AdmissionRefused, match="changed rate"):
+        controller.admit("worker-1", 3600.0, storage, reserve)
+    runpod.pods = [{**pod("pod-1", volume=VOLUME, mount=str(source)), "costPerHr": None}]
+    with pytest.raises(AdmissionRefused, match="missing or unknown fields"):
+        controller.admit("worker-1", 3600.0, storage, reserve)
+    with pytest.raises(StorageRefused, match="missing or unknown fields"):
+        check_storage(storage, adapter)
+    assert not (tmp_path / "admission" / "reservations.jsonl").exists()
+    refusals = [row for row in Journal(tmp_path / "journal.jsonl").read() if row["event"] == "admission-refused"]
+    assert len(refusals) == 6 and KEY not in (tmp_path / "journal.jsonl").read_text()
+
+
+def test_the_check_provider_command_reports_shapes_and_only_reads(runpod, tmp_path, capsys):
+    import json
+
+    from experiments.durability.__main__ import main
+
+    runpod.myself = {"clientBalance": 73.21, "currentSpendPerHr": 1.5, "spendLimit": 80}
+    config = {"kind": "runpod", "worker_pods": {"worker-1": "pod-1"}, "destination_per_hour": 0.0,
+              "storage_prices": dict(PRICES.__dict__), "local_pod_id": "pod-1"}       # no balance confirmation yet
+    path = tmp_path / "provider.json"
+    path.write_text(json.dumps(config))
+    arguments = ["check-provider", "--config", str(path), "--worker", "worker-1", "--path", "/workspace/study",
+                 "--runpod-rest-url", f"{runpod.url}/v1", "--runpod-graphql-url", f"{runpod.url}/graphql"]
+    assert main(arguments) == 0
+    printed = capsys.readouterr().out
+    report = json.loads(printed)
+    assert report["balance"] == {"answered": True, "amount_type": "float", "kind": UNCONFIRMED_BALANCE_KIND,
+                                 "recognized": False, "currency_stated": False}
+    assert report["rates"]["answered"] is False and report["rates"]["refused_as"] == "NotConfigured"
+    assert report["liabilities"] == {"answered": True, "count": 5, "attached_to_a_configured_worker": 2}
+    assert report["persistence"] == {"answered": True, "persistent": True}
+    assert report["shutdown"]["can_arm"] is False and report["creates_starts_stops_or_deletes"] is False
+    assert "73.21" not in printed and "pod-1" not in printed and KEY not in printed     # shapes, not account details
+    assert {method for method, _, _ in runpod.log} == {"GET", "POST"}
+    assert all("mutation" not in body for _, _, body in runpod.log)
+
+
+def test_wiring_builds_real_connectors_only_from_explicit_configuration(runpod, tmp_path, monkeypatch):
+    assert isinstance(destination_from(None), UnconfiguredDestination) and isinstance(provider_from(None), UnconfiguredProvider)
+    assert isinstance(destination_from(str(tmp_path / "d")), LocalDirectoryDestination)
+    assert destination_from(f"dir:{tmp_path / 'd'}").describe()["location"] == str(tmp_path / "d")
+    with pytest.raises(DurabilityError, match="declared free capacity"):
+        destination_from("github:owner/backups")
+    with pytest.raises(DurabilityError, match="GitHub options"):
+        destination_from(str(tmp_path / "d"), declared_free_bytes=1)
+    github = destination_from("github:owner/backups", declared_free_bytes=1 << 30, shards=8)
+    assert isinstance(github, GitHubReleaseDestination) and github.describe()["repository"] == "owner/backups"
+    monkeypatch.delenv("ATTRIBUTION_BACKUP_GITHUB_TOKEN", raising=False)
+    with pytest.raises(NotConfigured):                                # built, but closed without its token
+        github.free_bytes()
+    config = {"kind": "runpod", "worker_pods": {"worker-1": "pod-1"}, "destination_per_hour": 0.0,
+              "balance_confirmation": dict(CONFIRMATION.__dict__), "storage_prices": dict(PRICES.__dict__),
+              "local_pod_id": "pod-1"}
+    built = provider_from(config, rest_url=f"{runpod.url}/v1", graphql_url=f"{runpod.url}/graphql")
+    assert isinstance(built, RunPodProvider) and built.read_balance().recognized is True
+    assert provider_from({k: v for k, v in config.items() if k != "balance_confirmation"},
+                         rest_url=f"{runpod.url}/v1", graphql_url=f"{runpod.url}/graphql").read_balance().recognized is False
+    for bad in ({"kind": "other"}, {**config, "balance_confirmed": True}, {**config, "storage_prices": {"x": 1}},
+                {**config, "balance_confirmation": {"confirmed_by": "x"}}):
+        with pytest.raises(DurabilityError):
+            provider_from(bad)
diff -ruN pre-adapters/durability/transport.py adapters-final/durability/transport.py
--- pre-adapters/durability/transport.py	1970-01-01 05:30:00
+++ adapters-final/durability/transport.py	2026-10-03 18:57:00
@@ -0,0 +1,202 @@
+"""A small HTTPS client for the real connectors (stdlib ``urllib`` only).
+
+What the connectors need and nothing more:
+
+- **The secret stays in the environment.** The token is read from a named environment variable at
+  each request and sent as ``Authorization: Bearer`` only to the configured service hosts. It is
+  never stored on an object, logged, put in a URL or in an exception. A missing or empty variable
+  raises ``NotConfigured``; so does a 401.
+- **No credential on redirects.** Redirects are followed by hand (at most three) and *without* the
+  Authorization header: GitHub answers an asset download with a redirect to a signed storage URL,
+  which must not receive the token.
+- **HTTPS only**, except for a loopback host (the tests' fake services on 127.0.0.1).
+- **Bounded retries.** A rate-limit answer (429, or 403 with ``retry-after`` or
+  ``x-ratelimit-remaining: 0``) waits for the stated time when that is within ``max_wait_seconds``
+  and otherwise fails; a 5xx answer or a connection error backs off and retries. After
+  ``max_retries`` the call raises ``TransferError``. Nothing retries forever: a blocked copy means
+  no acknowledgement, and the dispatch gate then starts nothing.
+- **Errors name the method, host, path and status only**: never a header, a query string or a body.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import http.client
+import json
+import os
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Callable, Mapping, Sequence
+
+from .common import NotConfigured, TransferError
+
+__all__ = ["Http", "Reply", "next_link"]
+
+_REDIRECTS = (301, 302, 303, 307, 308)
+_TRANSIENT = (500, 502, 503, 504)
+_LOOPBACK = ("127.0.0.1", "localhost", "::1")
+
+
+class _NoRedirect(urllib.request.HTTPRedirectHandler):
+    """Redirects are returned to the caller, which follows them without credentials."""
+
+    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: D102 - urllib hook
+        return None
+
+
+@dataclass(frozen=True)
+class Reply:
+    status: int
+    headers: Mapping[str, str]
+    body: bytes
+    sha256: str | None = None      # of a streamed download
+    size: int | None = None
+
+    def json(self):
+        try:
+            return json.loads(self.body)
+        except ValueError as exc:
+            raise TransferError("the service answered with something that is not JSON") from exc
+
+
+def next_link(headers: Mapping[str, str]) -> str | None:
+    """The ``rel="next"`` URL of a ``Link`` header, or None."""
+    for part in headers.get("link", "").split(","):
+        url, _, rel = part.partition(";")
+        if 'rel="next"' in rel:
+            return url.strip().strip("<>")
+    return None
+
+
+class Http:
+    """See the module doc. ``bases``: the service URL prefixes that receive the token.
+    ``sleep`` and ``clock`` are injectable for tests."""
+
+    def __init__(self, *, token_env: str, bases: Sequence[str], user_agent: str = "attribution-durability",
+                 timeout: float = 60.0, max_retries: int = 4, max_wait_seconds: float = 120.0,
+                 sleep: Callable[[float], None] = time.sleep, clock: Callable[[], float] = time.time) -> None:
+        self.token_env, self.bases = token_env, tuple(base.rstrip("/") for base in bases)
+        self.user_agent, self.timeout = user_agent, timeout
+        self.max_retries, self.max_wait_seconds, self.sleep, self.clock = max_retries, max_wait_seconds, sleep, clock
+        self._opener = urllib.request.build_opener(_NoRedirect())
+        for base in self.bases:
+            self._check_url(base)
+
+    def __repr__(self) -> str:
+        return f"Http(token from ${self.token_env}, bases={list(self.bases)})"
+
+    @staticmethod
+    def _check_url(url: str) -> urllib.parse.SplitResult:
+        parts = urllib.parse.urlsplit(url)
+        if parts.scheme != "https" and not (parts.scheme == "http" and parts.hostname in _LOOPBACK):
+            raise TransferError(f"refusing a request to a non-HTTPS address ({parts.scheme}://{parts.hostname})")
+        return parts
+
+    @staticmethod
+    def _where(method: str, url: str) -> str:
+        parts = urllib.parse.urlsplit(url)
+        return f"{method} {parts.scheme}://{parts.netloc}{parts.path}"
+
+    def _token(self) -> str:
+        token = os.environ.get(self.token_env, "").strip()
+        if not token:
+            raise NotConfigured(f"the environment variable {self.token_env} is not set: this connector is not configured")
+        return token
+
+    def require_token(self) -> None:
+        """Raise ``NotConfigured`` unless the token variable is set (nothing is sent)."""
+        self._token()
+
+    def _wait(self, status: int, headers: Mapping[str, str]) -> float | None:
+        """Seconds a rate-limit answer asks to wait, or None when the answer is not a rate limit."""
+        if status not in (403, 429):
+            return None
+        if headers.get("retry-after", "").strip().isdigit():
+            return float(headers["retry-after"])
+        if headers.get("x-ratelimit-remaining", "").strip() == "0" and headers.get("x-ratelimit-reset", "").strip().isdigit():
+            return max(0.0, float(headers["x-ratelimit-reset"]) - self.clock())
+        return 60.0 if status == 429 else None
+
+    def request(self, method: str, url: str, *, headers: Mapping[str, str] | None = None,
+                body: bytes | Path | None = None, sink: Path | None = None) -> Reply:
+        """One request with the token, bounded retries and credential-free redirects. ``body``: bytes,
+        or a file to stream. ``sink``: stream the answer to this file and return its hash and size.
+        Returns every final answer that is not a rate limit, a 401 or an exhausted transient error;
+        the caller judges the status."""
+        self._token()   # fail closed before anything is sent
+        authorized, hops, attempt, backoff = True, 0, 0, 1.0
+        while True:
+            self._check_url(url)
+            send_token = authorized and any(url == base or url.startswith(base + "/") for base in self.bases)
+            request = urllib.request.Request(url, method=method)
+            request.add_header("User-Agent", self.user_agent)
+            for name, value in (headers or {}).items():
+                request.add_header(name, value)
+            if send_token:
+                request.add_header("Authorization", f"Bearer {self._token()}")
+            handle = None
+            if isinstance(body, Path):
+                handle = open(body, "rb")  # noqa: SIM115 - closed below, reopened for every attempt
+                request.data = handle
+                request.add_header("Content-Length", str(body.stat().st_size))
+            elif body is not None:
+                request.data = body
+                request.add_header("Content-Length", str(len(body)))
+            try:
+                with self._opener.open(request, timeout=self.timeout) as response:
+                    status = response.status
+                    reply_headers = {k.lower(): v for k, v in response.headers.items()}
+                    if sink is not None and status == 200:
+                        digest, size = hashlib.sha256(), 0
+                        sink.parent.mkdir(parents=True, exist_ok=True)
+                        with open(sink, "wb") as out:
+                            for block in iter(lambda: response.read(1 << 20), b""):
+                                out.write(block)
+                                digest.update(block)
+                                size += len(block)
+                            out.flush()
+                            os.fsync(out.fileno())
+                        return Reply(status, reply_headers, b"", digest.hexdigest(), size)
+                    return Reply(status, reply_headers, response.read())
+            except urllib.error.HTTPError as exc:
+                status, reply_headers = exc.code, {k.lower(): v for k, v in (exc.headers or {}).items()}
+                payload = exc.read()
+            except (urllib.error.URLError, OSError, http.client.HTTPException) as exc:
+                attempt += 1
+                if attempt > self.max_retries:
+                    raise TransferError(f"{self._where(method, url)} failed after {attempt} attempts "
+                                        f"({type(exc).__name__})") from None
+                self.sleep(backoff)
+                backoff = min(backoff * 2.0, 30.0)
+                continue
+            finally:
+                if handle is not None:
+                    handle.close()
+            if status in _REDIRECTS and reply_headers.get("location"):
+                hops += 1
+                if hops > 3:
+                    raise TransferError(f"{self._where(method, url)} redirected too many times")
+                url, authorized = urllib.parse.urljoin(url, reply_headers["location"]), False
+                continue
+            if status == 401:
+                raise NotConfigured(f"the token in {self.token_env} was rejected ({self._where(method, url)} -> 401)")
+            wait = self._wait(status, reply_headers)
+            if wait is not None:
+                attempt += 1
+                if wait > self.max_wait_seconds or attempt > self.max_retries:
+                    raise TransferError(f"{self._where(method, url)} is rate limited (status {status}); the stated "
+                                        f"wait of {wait:.0f} s is beyond the bound or the retries are used up")
+                self.sleep(wait + 1.0)
+                continue
+            if status in _TRANSIENT:
+                attempt += 1
+                if attempt > self.max_retries:
+                    raise TransferError(f"{self._where(method, url)} kept failing (status {status})")
+                self.sleep(backoff)
+                backoff = min(backoff * 2.0, 30.0)
+                continue
+            return Reply(status, reply_headers, payload)
diff -ruN pre-adapters/durability/wiring.py adapters-final/durability/wiring.py
--- pre-adapters/durability/wiring.py	1970-01-01 05:30:00
+++ adapters-final/durability/wiring.py	2026-10-03 19:01:08
@@ -0,0 +1,59 @@
+"""Building the real connectors from explicit configuration (stdlib only). The defaults stay
+fail-closed: no destination spec gives ``UnconfiguredDestination``, no provider configuration gives
+``UnconfiguredProvider``. Nothing here reads a credential: the connectors take their token from
+the environment when they make a request."""
+
+from __future__ import annotations
+
+from typing import Mapping
+
+from .admission import Provider, UnconfiguredProvider
+from .common import DurabilityError
+from .destination import Destination, LocalDirectoryDestination, UnconfiguredDestination
+from .github_destination import GitHubReleaseDestination
+from .runpod_provider import BalanceConfirmation, RunPodConfig, RunPodProvider, StoragePrices
+
+__all__ = ["destination_from", "provider_from"]
+
+_RUNPOD_KEYS = {"kind", "worker_pods", "balance_confirmation", "storage_prices", "destination_per_hour",
+                "local_pod_id", "spend_tolerance_per_hour"}
+
+
+def destination_from(spec: str | None, **github: object) -> Destination:
+    """``None`` or empty: not configured (every call refuses). ``github:owner/repo``: release assets of
+    that repository (``declared_free_bytes`` is required; other keywords go to
+    ``GitHubReleaseDestination``). ``dir:PATH`` or a plain path: a local directory."""
+    if not spec:
+        return UnconfiguredDestination("remote")
+    if spec.startswith("github:"):
+        if "declared_free_bytes" not in github:
+            raise DurabilityError("a GitHub destination needs its declared free capacity (GitHub reports none)")
+        return GitHubReleaseDestination(spec[len("github:"):], **github)
+    if github:
+        raise DurabilityError("GitHub options were given for a destination that is not github:owner/repo")
+    return LocalDirectoryDestination(spec[len("dir:"):] if spec.startswith("dir:") else spec)
+
+
+def provider_from(config: Mapping | None, **options: object) -> Provider:
+    """``None``: not configured (every call refuses). ``{"kind": "runpod", ...}``: a ``RunPodProvider``
+    from the mapping's ``worker_pods`` and, where the operator recorded them, ``balance_confirmation``,
+    ``storage_prices``, ``destination_per_hour`` and ``local_pod_id``. An unknown key or kind refuses:
+    a misspelt confirmation must not be silently ignored."""
+    if config is None:
+        return UnconfiguredProvider()
+    if not isinstance(config, Mapping) or config.get("kind") != "runpod":
+        raise DurabilityError("the provider configuration names no known kind")
+    unknown = sorted(set(config) - _RUNPOD_KEYS)
+    if unknown:
+        raise DurabilityError(f"unknown provider configuration keys {unknown}")
+    try:
+        confirmation = config.get("balance_confirmation")
+        prices = config.get("storage_prices")
+        fields = {key: config[key] for key in ("destination_per_hour", "local_pod_id", "spend_tolerance_per_hour")
+                  if key in config}
+        built = RunPodConfig(worker_pods=dict(config.get("worker_pods") or {}),
+                             balance_confirmation=None if confirmation is None else BalanceConfirmation(**confirmation),
+                             storage_prices=None if prices is None else StoragePrices(**prices), **fields)
+    except TypeError as exc:
+        raise DurabilityError(f"the provider configuration is malformed ({exc})") from None
+    return RunPodProvider(built, **options)
