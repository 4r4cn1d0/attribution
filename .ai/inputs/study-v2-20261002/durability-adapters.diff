--- pre-adapters/durability/tests/fake_github.py	1970-01-01 05:30:00
+++ adapters-final/durability/tests/fake_github.py	2026-10-03 18:57:00
@@ -0,0 +1,212 @@
+"""A fake GitHub REST API on 127.0.0.1 for the connector tests (ENGINEERING FIXTURE). It implements
+only what ``GitHubReleaseDestination`` uses, with the documented behaviours the connector relies on:
+create-only asset names (422 on a duplicate), a tag that cannot be created twice, pagination with
+``Link`` headers, binary downloads through a redirect, asset states, and scripted faults (a 502 that
+leaves a ``starter`` asset, rate-limit answers, stored bytes that differ from what was sent). It is
+not GitHub and proves nothing about GitHub's real behaviour."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import threading
+import urllib.parse
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+TOKEN = "fake-token-0123456789-never-a-real-credential"
+
+
+class FakeGitHub:
+    """State and scripted faults. ``faults``: a list of dicts consumed in order by the first matching
+    request, each ``{"on": "upload"|"any"|"download"|"list", "status": int, "headers": {...},
+    "starter": bool}``. ``corrupt``/``truncate``: upload ordinals (1-based) whose stored bytes are
+    altered. ``page``: the server's page size cap."""
+
+    def __init__(self, repository: str = "owner/backups", page: int = 100, digests: bool = True) -> None:
+        self.repository, self.page, self.digests = repository, page, digests
+        self.releases: dict[int, dict] = {}
+        self.assets: dict[int, dict] = {}
+        self.blobs: dict[int, bytes] = {}
+        self.faults: list[dict] = []
+        self.corrupt: set[int] = set()
+        self.truncate: set[int] = set()
+        self.uploads = 0
+        self.log: list[tuple[str, str, bool]] = []     # (method, path with query, had an Authorization header)
+        self.leaks: list[str] = []                     # requests that carried the token where they must not
+        self.mangle_labels = False
+        self._ids = 1000
+        self._lock = threading.RLock()
+        self._server = ThreadingHTTPServer(("127.0.0.1", 0), self._handler())
+        self.url = f"http://127.0.0.1:{self._server.server_address[1]}"
+        self._thread = threading.Thread(target=self._server.serve_forever, daemon=True)
+        self._thread.start()
+
+    def close(self) -> None:
+        self._server.shutdown()
+        self._server.server_close()
+
+    def _next(self) -> int:
+        self._ids += 1
+        return self._ids
+
+    def names(self, state: str = "uploaded") -> list[str]:
+        """The labels (keys) of every asset in a state, sorted."""
+        with self._lock:
+            return sorted(a["label"] for a in self.assets.values() if a["state"] == state)
+
+    def asset_json(self, asset: dict) -> dict:
+        label = asset["label"][::-1] if self.mangle_labels else asset["label"]
+        return {"id": asset["id"], "name": asset["name"], "label": label, "state": asset["state"],
+                "size": asset["size"], "digest": asset["digest"] if self.digests else None,
+                "url": f"{self.url}/repos/{self.repository}/releases/assets/{asset['id']}"}
+
+    def _handler(self):
+        fake = self
+
+        class Handler(BaseHTTPRequestHandler):
+            protocol_version = "HTTP/1.1"
+
+            def log_message(self, *args):  # noqa: D102 - silence the test server
+                return
+
+            def _send(self, status: int, body=None, headers=None) -> None:
+                data = b"" if body is None else (body if isinstance(body, bytes) else json.dumps(body).encode())
+                self.send_response(status)
+                for name, value in (headers or {}).items():
+                    self.send_header(name, value)
+                self.send_header("Content-Length", str(len(data)))
+                self.end_headers()
+                self.wfile.write(data)
+
+            def _fault(self, kind: str) -> bool:
+                with fake._lock:
+                    for fault in fake.faults:
+                        if fault["on"] in (kind, "any"):
+                            fake.faults.remove(fault)
+                            self._send(fault["status"], {"message": "ENGINEERING FIXTURE fault"}, fault.get("headers"))
+                            return True
+                return False
+
+            def _route(self, method: str) -> None:
+                parts = urllib.parse.urlsplit(self.path)
+                query = urllib.parse.parse_qs(parts.query)
+                authorized = self.headers.get("Authorization") == f"Bearer {TOKEN}"
+                length = int(self.headers.get("Content-Length") or 0)
+                body = self.rfile.read(length) if length else b""
+                with fake._lock:
+                    fake.log.append((method, self.path, "Authorization" in self.headers))
+                    if TOKEN in self.path:
+                        fake.leaks.append(f"token in a URL: {method} {parts.path}")
+                path = parts.path
+                if path.startswith("/_blob/"):                         # the signed storage URL of a download
+                    if "Authorization" in self.headers:
+                        fake.leaks.append("the token was forwarded on a redirect")
+                    return self._send(200, fake.blobs[int(path.rsplit("/", 1)[1])],
+                                      {"Content-Type": "application/octet-stream"})
+                if not authorized:
+                    return self._send(401, {"message": "Bad credentials"})
+                base = f"/repos/{fake.repository}"
+                if not path.startswith(base):
+                    return self._send(404, {"message": "Not Found"})
+                rest = path[len(base):]
+                if method == "GET" and (m := re.fullmatch(r"/releases/tags/(.+)", rest)):
+                    if self._fault("any"):
+                        return None
+                    found = [r for r in fake.releases.values() if r["tag_name"] == m.group(1)]
+                    return self._send(200, found[0]) if found else self._send(404, {"message": "Not Found"})
+                if method == "POST" and rest == "/releases":
+                    spec = json.loads(body)
+                    with fake._lock:
+                        if any(r["tag_name"] == spec["tag_name"] for r in fake.releases.values()):
+                            return self._send(422, {"message": "Validation Failed", "errors": [{"code": "already_exists"}]})
+                        release = {"id": fake._next(), "tag_name": spec["tag_name"], "name": spec.get("name"),
+                                   "draft": spec.get("draft", False), "prerelease": spec.get("prerelease", False)}
+                        fake.releases[release["id"]] = release
+                    return self._send(201, release)
+                if method == "GET" and rest == "/releases":
+                    if self._fault("list"):
+                        return None
+                    return self._page(sorted(fake.releases.values(), key=lambda r: r["id"]), query, path)
+                if method == "GET" and (m := re.fullmatch(r"/releases/(\d+)/assets", rest)):
+                    if self._fault("list"):
+                        return None
+                    release_id = int(m.group(1))
+                    with fake._lock:
+                        items = [fake.asset_json(a) for a in sorted(fake.assets.values(), key=lambda a: a["id"])
+                                 if a["release"] == release_id]
+                    return self._page(items, query, path)
+                if method == "POST" and (m := re.fullmatch(r"/releases/(\d+)/assets", rest)):
+                    return self._upload(int(m.group(1)), query, body)
+                if (m := re.fullmatch(r"/releases/assets/(\d+)", rest)):
+                    asset_id = int(m.group(1))
+                    with fake._lock:
+                        asset = fake.assets.get(asset_id)
+                    if asset is None:
+                        return self._send(404, {"message": "Not Found"})
+                    if method == "DELETE":
+                        with fake._lock:
+                            fake.assets.pop(asset_id, None)
+                            fake.blobs.pop(asset_id, None)
+                        return self._send(204)
+                    if method == "GET" and self.headers.get("Accept") == "application/octet-stream":
+                        if self._fault("download"):
+                            return None
+                        return self._send(302, None, {"Location": f"{fake.url}/_blob/{asset_id}"})
+                    if method == "GET":
+                        return self._send(200, fake.asset_json(asset))
+                return self._send(404, {"message": "Not Found"})
+
+            def _page(self, items: list, query: dict, path: str) -> None:
+                size = min(int(query.get("per_page", ["30"])[0]), fake.page)
+                page = int(query.get("page", ["1"])[0])
+                chunk = items[(page - 1) * size:page * size]
+                headers = {}
+                if page * size < len(items):
+                    headers["Link"] = f'<{fake.url}{path}?per_page={size}&page={page + 1}>; rel="next"'
+                self._send(200, chunk, headers)
+
+            def _upload(self, release_id: int, query: dict, body: bytes) -> None:
+                name, label = query["name"][0], query.get("label", [None])[0]
+                with fake._lock:
+                    if release_id not in fake.releases:
+                        return self._send(404, {"message": "Not Found"})
+                    if any(a["release"] == release_id and a["name"] == name for a in fake.assets.values()):
+                        return self._send(422, {"message": "Validation Failed", "errors": [{"code": "already_exists"}]})
+                    for fault in fake.faults:
+                        if fault["on"] in ("upload", "any"):
+                            fake.faults.remove(fault)
+                            if fault.get("starter"):
+                                asset_id = fake._next()
+                                fake.assets[asset_id] = {"id": asset_id, "release": release_id, "name": name,
+                                                         "label": label, "state": "starter", "size": 0, "digest": None}
+                                fake.blobs[asset_id] = b""
+                            return self._send(fault["status"], {"message": "ENGINEERING FIXTURE fault"},
+                                              fault.get("headers"))
+                    fake.uploads += 1
+                    stored = body
+                    if fake.uploads in fake.truncate:
+                        stored = body[:-1]
+                    if fake.uploads in fake.corrupt:
+                        stored = bytes([body[0] ^ 0xFF]) + body[1:]
+                    asset_id = fake._next()
+                    # what GitHub reports describes what it received; the stored bytes are the fault
+                    fake.assets[asset_id] = {"id": asset_id, "release": release_id, "name": name, "label": label,
+                                             "state": "uploaded", "size": len(body),
+                                             "digest": "sha256:" + hashlib.sha256(body).hexdigest()}
+                    fake.blobs[asset_id] = stored
+                    return self._send(201, fake.asset_json(fake.assets[asset_id]))
+
+            def do_GET(self):  # noqa: N802,D102
+                self._route("GET")
+
+            def do_POST(self):  # noqa: N802,D102
+                self._route("POST")
+
+            def do_DELETE(self):  # noqa: N802,D102
+                self._route("DELETE")
+
+            def do_PATCH(self):  # noqa: N802,D102
+                self._route("PATCH")
+
+        return Handler
diff -ruN pre-adapters/durability/tests/fake_runpod.py adapters-final/durability/tests/fake_runpod.py
--- pre-adapters/durability/tests/fake_runpod.py	1970-01-01 05:30:00
+++ adapters-final/durability/tests/fake_runpod.py	2026-10-03 19:02:17
@@ -0,0 +1,88 @@
+"""A fake RunPod API on 127.0.0.1 for the provider tests (ENGINEERING FIXTURE): the REST lists of
+pods and network volumes and the GraphQL account query, with the field names RunPod documents. It
+records every request so the tests can show that the provider only reads. It is not RunPod and
+proves nothing about RunPod's real answers."""
+
+from __future__ import annotations
+
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+KEY = "fake-runpod-key-0123456789-never-a-real-credential"
+
+
+def pod(pod_id: str, *, status: str = "RUNNING", cost: float = 1.6, volume: dict | None = None,
+        mount: str | None = "/workspace", container_gb: int = 20, volume_gb: int = 0, **more) -> dict:
+    return {"id": pod_id, "name": f"pod-{pod_id}", "desiredStatus": status, "costPerHr": cost,
+            "adjustedCostPerHr": cost, "containerDiskInGb": container_gb, "volumeInGb": volume_gb,
+            "volumeMountPath": mount, "networkVolume": volume, **more}
+
+
+def network_volume(volume_id: str, size: int = 100) -> dict:
+    return {"id": volume_id, "name": f"volume-{volume_id}", "size": size, "dataCenterId": "EU-FIXTURE-1"}
+
+
+class FakeRunPod:
+    def __init__(self) -> None:
+        self.pods: object = []
+        self.volumes: object = []
+        self.myself: object = {"clientBalance": 100.0, "currentSpendPerHr": 0.0, "spendLimit": 80}
+        self.graphql_errors = None
+        self.log: list[tuple[str, str, str]] = []      # (method, path, body)
+        self._server = ThreadingHTTPServer(("127.0.0.1", 0), self._handler())
+        self.url = f"http://127.0.0.1:{self._server.server_address[1]}"
+        threading.Thread(target=self._server.serve_forever, daemon=True).start()
+
+    def close(self) -> None:
+        self._server.shutdown()
+        self._server.server_close()
+
+    def _handler(self):
+        fake = self
+
+        class Handler(BaseHTTPRequestHandler):
+            protocol_version = "HTTP/1.1"
+
+            def log_message(self, *args):  # noqa: D102
+                return
+
+            def _send(self, status: int, body) -> None:
+                data = json.dumps(body).encode()
+                self.send_response(status)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(data)))
+                self.end_headers()
+                self.wfile.write(data)
+
+            def _route(self, method: str) -> None:
+                length = int(self.headers.get("Content-Length") or 0)
+                body = self.rfile.read(length).decode() if length else ""
+                fake.log.append((method, self.path, body))
+                if self.headers.get("Authorization") != f"Bearer {KEY}":
+                    return self._send(401, {"error": "unauthorized"})
+                path = self.path.split("?")[0]
+                if method == "GET" and path == "/v1/pods":
+                    return self._send(200, fake.pods)
+                if method == "GET" and path == "/v1/networkvolumes":
+                    return self._send(200, fake.volumes)
+                if method == "POST" and path == "/graphql":
+                    answer = {"data": {"myself": fake.myself}}
+                    if fake.graphql_errors:
+                        answer = {"errors": fake.graphql_errors}
+                    return self._send(200, answer)
+                return self._send(404, {"error": "not found"})
+
+            def do_GET(self):  # noqa: N802,D102
+                self._route("GET")
+
+            def do_POST(self):  # noqa: N802,D102
+                self._route("POST")
+
+            def do_DELETE(self):  # noqa: N802,D102
+                self._route("DELETE")
+
+            def do_PATCH(self):  # noqa: N802,D102
+                self._route("PATCH")
+
+        return Handler
diff -ruN pre-adapters/durability/tests/test_dur_github.py adapters-final/durability/tests/test_dur_github.py
--- pre-adapters/durability/tests/test_dur_github.py	1970-01-01 05:30:00
+++ adapters-final/durability/tests/test_dur_github.py	2026-10-03 19:03:29
@@ -0,0 +1,343 @@
+"""``GitHubReleaseDestination`` against a fake GitHub API on 127.0.0.1 (ENGINEERING FIXTURES; no
+request leaves the machine). First the ``Destination`` contract on release assets: create-only
+commits and records, read-back hashes, listing by prefix across shards and pages, staging-only
+discards, the 2 GiB and assets-per-release limits, torn uploads, bounded rate-limit handling and a
+token that is required, sent only to the service and never shown. Then the decisive check: the
+vault's acknowledgement protocol on real sealed engine units through this connector
+(acknowledgement and duplicates, partial and corrupt uploads, a crash before and after the
+acknowledgement, a collision with both kept, restore). The fake proves nothing about GitHub itself:
+what waits for a live check is listed in the README."""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import pytest
+
+import dur_fixtures as dur
+from fake_github import TOKEN, FakeGitHub
+
+from experiments.durability.common import (CapacityError, CollisionError, NotConfigured, TransferError,
+                                           VerificationFailed, sha256_bytes, sha256_file)
+from experiments.durability.github_destination import GITHUB_TOKEN_ENV, GitHubReleaseDestination
+
+
+@pytest.fixture
+def github(monkeypatch):
+    fake = FakeGitHub()
+    monkeypatch.setenv(GITHUB_TOKEN_ENV, TOKEN)
+    yield fake
+    fake.close()
+
+
+def connect(fake: FakeGitHub, tmp_path: Path, sleeps: list | None = None, **options) -> GitHubReleaseDestination:
+    options.setdefault("declared_free_bytes", 1 << 40)
+    options.setdefault("shards", 4)
+    return GitHubReleaseDestination(fake.repository, api_url=fake.url, upload_url=fake.url,
+                                    cache_dir=tmp_path / "read-back", sleep=(sleeps if sleeps is not None else []).append,
+                                    **options)
+
+
+def staged(destination, tmp_path: Path, key: str, data: bytes) -> str:
+    source = tmp_path / f"source-{sha256_bytes(key.encode())[:8]}"
+    source.write_bytes(data)
+    destination.upload(source, key)
+    return key
+
+
+def test_the_destination_contract_holds_on_release_assets(github, tmp_path):
+    github.page = 2                                   # every listing is paginated
+    destination = connect(github, tmp_path)
+    stage = staged(destination, tmp_path, "w1/staging/u-1/job.json", b"alpha")
+    assert destination.exists(stage) and destination.sha256(stage) == (sha256_bytes(b"alpha"), 5)
+    assert destination.commit(stage, "w1/tree/workspace/run/job.json") is True
+    assert destination.exists("w1/tree/workspace/run/job.json") and not destination.exists(stage)
+    assert destination.read("w1/tree/workspace/run/job.json") == b"alpha"
+    # the same bytes again: reused; other bytes: a collision, the final object untouched, the staged copy kept
+    again = staged(destination, tmp_path, "w1/staging/u-2/job.json", b"alpha")
+    assert destination.commit(again, "w1/tree/workspace/run/job.json") is False and not destination.exists(again)
+    other = staged(destination, tmp_path, "w1/staging/u-3/job.json", b"omega")
+    with pytest.raises(CollisionError):
+        destination.commit(other, "w1/tree/workspace/run/job.json")
+    assert destination.read("w1/tree/workspace/run/job.json") == b"alpha" and destination.exists(other)
+    # exclusive records
+    assert destination.put_new("w1/acks/unit.json", b"{}") is True
+    assert destination.put_new("w1/acks/unit.json", b"{}") is False
+    with pytest.raises(CollisionError):
+        destination.put_new("w1/acks/unit.json", b"{ }")
+    # a staging name may be overwritten; final names and non-staging uploads may not
+    staged(destination, tmp_path, other, b"omega-2")
+    assert destination.sha256(other) == (sha256_bytes(b"omega-2"), 7)
+    with pytest.raises(TransferError, match="staging area only"):
+        destination.upload(tmp_path / "source-x", "w1/tree/workspace/x")
+    with pytest.raises(TransferError, match="only staging objects"):
+        destination.discard("w1/acks/unit.json")
+    destination.discard(other)
+    assert not destination.exists(other)
+    # listing by prefix, across shards and pages, like a directory listing
+    for index in range(7):
+        destination.put_new(f"w1/tree/workspace/run/file-{index}", str(index).encode())
+    destination.put_new("w1/tree/workspace/run-2/file", b"x")
+    destination.put_new("w2/tree/workspace/run/file", b"y")
+    fresh = connect(github, tmp_path)                 # a new process reads the index from the service
+    assert fresh.list("w1/tree/workspace/run") == sorted(
+        ["w1/tree/workspace/run/job.json", *(f"w1/tree/workspace/run/file-{i}" for i in range(7))])
+    assert fresh.list("w1/acks/") == ["w1/acks/unit.json"] and fresh.list("w3") == []
+    assert len(github.releases) > 1 and all(len(a["name"]) == 64 for a in github.assets.values())
+    target = tmp_path / "out" / "job.json"
+    fresh.download("w1/tree/workspace/run/job.json", target)
+    assert target.read_bytes() == b"alpha" and fresh.sha256("w1/tree/workspace/run/job.json")[0] == sha256_file(target)
+    fresh.probe()
+    assert not [name for name in github.names() if "probe" in name]
+    with pytest.raises(TransferError, match="not stored"):
+        fresh.read("w1/tree/missing")
+    # the token went to the service only: never in a URL, never to the download location
+    assert github.leaks == [] and all(had for method, path, had in github.log if not path.startswith("/_blob/"))
+    assert any(path.startswith("/_blob/") for _, path, _ in github.log)
+    assert TOKEN not in repr(destination) + repr(destination.http) + str(destination.describe())
+    assert destination.describe() == {"kind": "github-release-assets", "location": None, "repository": "owner/backups",
+                                      "scheme": "durability-v1", "shards": 4, "assets_per_release": 1000,
+                                      "declared_free_bytes": 1 << 40}
+    assert destination.free_bytes() == 1 << 40
+
+
+def test_without_a_token_or_with_a_rejected_one_every_call_refuses_and_nothing_shows_it(github, tmp_path, monkeypatch):
+    destination = connect(github, tmp_path)
+    destination.put_new("w1/acks/a.json", b"{}")
+    calls = (destination.free_bytes, destination.probe, lambda: destination.exists("w1/acks/a.json"),
+             lambda: destination.read("w1/acks/a.json"), lambda: destination.put_new("w1/acks/b.json", b"{}"),
+             lambda: destination.list("w1"), lambda: destination.sha256("w1/acks/a.json"),
+             lambda: destination.upload(tmp_path / "missing", "w1/staging/x"))
+    monkeypatch.delenv(GITHUB_TOKEN_ENV)
+    seen = len(github.log)
+    for call in calls:
+        with pytest.raises(NotConfigured, match=GITHUB_TOKEN_ENV):
+            call()
+    with pytest.raises(NotConfigured, match=GITHUB_TOKEN_ENV):
+        connect(github, tmp_path / "new").list("w1")
+    assert len(github.log) == seen                    # nothing was sent
+    monkeypatch.setenv(GITHUB_TOKEN_ENV, "another-wrong-secret-value")
+    with pytest.raises(NotConfigured) as refused:
+        connect(github, tmp_path / "wrong").put_new("w1/acks/c.json", b"{}")
+    assert "rejected" in str(refused.value) and "another-wrong-secret-value" not in str(refused.value)
+    with pytest.raises(TransferError, match="non-HTTPS"):
+        GitHubReleaseDestination("owner/backups", declared_free_bytes=1, api_url="http://example.org")
+    for bad in ({"repository": "not a repo"}, {"scheme": "Bad Scheme"}, {"shards": 0}, {"assets_per_release": 1001},
+                {"max_file_bytes": 2 * 1024 ** 3 + 1}, {"declared_free_bytes": -1}):
+        options = {"repository": "owner/backups", "declared_free_bytes": 1, **bad}
+        with pytest.raises(TransferError):
+            GitHubReleaseDestination(options.pop("repository"), **options)
+
+
+def test_rate_limits_and_transient_errors_are_retried_within_a_bound_and_then_fail(github, tmp_path):
+    sleeps: list[float] = []
+    destination = connect(github, tmp_path, sleeps)
+    soon = str(int(time.time()) + 5)
+    github.faults = [{"on": "upload", "status": 403, "headers": {"x-ratelimit-remaining": "0", "x-ratelimit-reset": soon}},
+                     {"on": "upload", "status": 429, "headers": {"retry-after": "2"}},
+                     {"on": "upload", "status": 502}]
+    assert destination.put_new("w1/acks/a.json", b"{}") is True
+    assert len(sleeps) == 3 and 3.0 <= sleeps[0] <= 7.0 and sleeps[1] == 3.0 and github.faults == []
+    # a wait beyond the bound is not waited for: the call fails and nothing is acknowledged upstream
+    sleeps.clear()
+    later = str(int(time.time()) + 3600)
+    github.faults = [{"on": "upload", "status": 403, "headers": {"x-ratelimit-remaining": "0", "x-ratelimit-reset": later}}]
+    with pytest.raises(TransferError, match="rate limited"):
+        destination.put_new("w1/acks/b.json", b"{}")
+    assert sleeps == [] and not destination.exists("w1/acks/b.json")
+    # a 403 that is not a rate limit (a token without the permission) is not retried
+    github.faults = [{"on": "upload", "status": 403}]
