+def a_done_c(w) -> list[str]:
+    """Block A of OLMo-2-7B under [C], every host pulled and recorded; the governing simulation pinned for [C]."""
+    hosts = released_a(w)
+    for host in hosts:
+        pull_planted(w, host)
+        w.tool.record_done(host)
+    s = SR2.__new__(SR2)
+    s.w, s.families = w, ("olmo2-7b",)
+    s.sim("C")
+    return hosts
