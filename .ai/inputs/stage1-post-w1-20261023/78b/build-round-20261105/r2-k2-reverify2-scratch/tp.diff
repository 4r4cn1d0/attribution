+    (w.root / "plan.json").write_text(json.dumps(a))
+    rec = w.tool.record_plan_b_78b(str(w.noise), None, None, "test", str(w.repo / "records" / "pb-not.json"))
+    assert (rec["sr2_adopted"], rec["sr2_reason"]) == (False, "blinding_test_not_verified")
