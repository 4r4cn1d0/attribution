+    files = ((values["W1_18_78B"] if kind == "w1_18" else values["OEXT_78B"]) or {}).get("files") or {}
+    need = (r78.OEXT_WRAPPER_78B, *(f.format(family=family) for f in OEXT_COMMAND_FILES[word]))
+    missing = [f for f in need if f not in files]
