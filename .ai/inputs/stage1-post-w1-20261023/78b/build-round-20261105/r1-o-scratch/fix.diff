+            state = "listed"
+            if not isinstance(digest, str) or not HEX64.match(digest):
+                state = "not listed"
+                problems.append(f"{name}: COMPLETE.json lists no SHA-256 for {rel}")
+            elif not (folder / rel).is_file():
