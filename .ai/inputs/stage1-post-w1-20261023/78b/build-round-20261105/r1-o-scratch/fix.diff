+def check_side_units(idx: Index, data_root: str) -> dict:
+    """R-9: each listed side unit's COMPLETE.json, read by its pin, lists every file W1-18 reads by name with a
+    SHA-256, and each present file's bytes hash to it (hashed, never parsed); job.json equals its pin where filled."""
+    _, _, w_doc = idx.file("limits_overrefusal_checks")
