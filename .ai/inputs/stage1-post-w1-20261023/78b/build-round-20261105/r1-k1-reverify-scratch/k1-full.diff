+           "plan_basis": "sigma_A", "blinded_sigma_output_sha256": hx("bs-out"), "blinded_sigma_inputs_sha256": hx("bs-in"),
+           "utc": "2026-12-01T10:00:00Z", "recorded_by": "GI XI"}
